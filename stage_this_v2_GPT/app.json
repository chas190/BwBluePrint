{
  "expo": {
    "name": "Stage This",
    "slug": "stage-this",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stage-this",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "single"
    },
    "splash": {
      "backgroundColor": "#F7F4ED",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/BwBluePrint/stage_this_v2_GPT"
    }
  }
}
